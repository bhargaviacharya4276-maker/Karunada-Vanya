<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/card_background" android:orientation="horizontal"
    android:padding="14dp" android:layout_marginBottom="10dp"
    android:gravity="center_vertical" android:clickable="true" android:focusable="true">

    <TextView android:id="@+id/itemEmoji"
        android:layout_width="56dp" android:layout_height="56dp"
        android:background="@drawable/surface_bg" android:gravity="center"
        android:textSize="32sp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/itemName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/text_primary"/>
        <TextView android:id="@+id/itemSci" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:textColor="@color/text_muted" android:textStyle="italic" android:layout_marginTop="1dp"/>
        <LinearLayout android:id="@+id/tagContainer" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="›" android:textSize="18sp" android:textColor="@color/card_border"/>
</LinearLayout>
