<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/forest_dark" android:orientation="vertical" android:padding="16dp">
            <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="‹ Back" android:textColor="@color/white" android:background="?attr/selectableItemBackground"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Report a Sighting" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_background" android:orientation="vertical"
            android:padding="16dp" android:layout_margin="14dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="What did you see?" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SELECT ANIMAL" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginBottom="8dp"/>

            <GridLayout android:id="@+id/animalGrid" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:columnCount="2" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LOCATION / LANDMARK" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/inputLocation" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="e.g. Near the mango grove, east side"
                android:background="@drawable/input_bg" android:padding="10dp" android:textSize="13sp" android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DESCRIBE WHAT YOU SAW" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/inputDesc" android:layout_width="match_parent" android:layout_height="80dp"
                android:hint="How many animals? Which direction?" android:background="@drawable/input_bg"
                android:padding="10dp" android:textSize="13sp" android:gravity="top" android:layout_marginBottom="14dp" android:inputType="textMultiLine"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="URGENCY LEVEL" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spinnerUrgency" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/input_bg" android:padding="10dp" android:layout_marginBottom="14dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/ecological_card_bg" android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⏱ Alert will auto-expire after 6 hours" android:textColor="@color/forest_dark" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Timestamp will be added automatically" android:textColor="@color/text_muted" android:textSize="11sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <Button android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="🚨 Send Community Alert" android:background="@drawable/btn_danger"
                android:textColor="@color/white" android:textSize="14sp" android:padding="14dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
